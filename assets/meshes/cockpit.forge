# --- nose cowl ------------------------------------------------------------
# A four-sided taper from the windscreen base out to a point ahead of the eye.
# Offsets from the eye: A/B (-+0.34, -0.68, -1.00), C/D (-+0.34, -0.46, -1.00),
# tip (0, -0.54, -1.95).

[[part]]
id = "cowl_upper"
type = "flat_triangle"
p0 = [-0.34, 0.34, -6.0]
p1 = [0.34, 0.34, -6.0]
p2 = [0.0, 0.26, -6.95]
uv0 = [0.0, 0.0]
uv1 = [1.0, 0.0]
uv2 = [0.5, 1.0]

[[part]]
id = "cowl_lower"
type = "flat_triangle"
p0 = [0.34, 0.12, -6.0]
p1 = [-0.34, 0.12, -6.0]
p2 = [0.0, 0.26, -6.95]
uv0 = [0.0, 0.0]
uv1 = [1.0, 0.0]
uv2 = [0.5, 1.0]

[[part]]
