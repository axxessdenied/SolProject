type = "flat_triangle"
p0 = [-0.34, 0.12, -6.0]
p1 = [-0.34, 0.34, -6.0]
p2 = [0.0, 0.26, -6.95]
uv0 = [0.0, 0.0]
uv1 = [1.0, 0.0]
uv2 = [0.5, 1.0]

[[part]]
