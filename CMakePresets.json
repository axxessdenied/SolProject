{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc-base",
      "displayName": "Windows MSVC Debug",
      "description": "Single-configuration Debug tree (ADR 0001). Diagnostics enabled; not for performance evidence.",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOL_BUILD_PRESET": "windows-msvc-debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "inherits": "windows-msvc-base",
      "displayName": "Windows MSVC Release",
      "description": "Single-configuration Release tree (ADR 0001). The only configuration that may produce performance evidence.",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SOL_BUILD_PRESET": "windows-msvc-release"
      }
    },
    {
      "name": "windows-msvc-release-negcontrol-contract",
      "inherits": "windows-msvc-release",
      "displayName": "Windows MSVC Release (ADR 0010 negative control)",
      "description": "Deliberately enables /fp:contract to prove the determinism harness detects a floating-point flag change. Never use for evidence.",
      "binaryDir": "${sourceDir}/build/windows-msvc-release-negcontrol-contract",
      "cacheVariables": {
        "SOL_BUILD_PRESET": "windows-msvc-release-negcontrol-contract",
        "SOL_NEGATIVE_CONTROL_CONTRACT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-release-negcontrol-contract",
      "configurePreset": "windows-msvc-release-negcontrol-contract"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release-negcontrol-contract",
      "configurePreset": "windows-msvc-release-negcontrol-contract",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
